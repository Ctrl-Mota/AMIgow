{
  "api_key": "your-secret-key",
  "base_path": "/amigow",
  "server_host": "https://[host]",
  "ami_servers": [
    {
      "id": "teste-1",
      "host": "localhost",
      "port": 5038,
      "username": "amigow",
      "password": "TNwVn82RCNMXgA",
      "webhooks": [
        {
          "url": "https://[your-host]/api/ami-webhook",
          "timeout_seconds": 10,
          "events_filter": ["answer", "hangup", "missed", "invite"]
        }
      ]
    }
  ],
  "config_api_url": "http://localhost:9000/config",
  "config_refresh_minutes": 5,

  "api_connect": {
    "host": "https://[your-host]",
    "path_resolver": "/asterisk-egress/dynamic-resolver",
    "path_open_gate": "/asterisk-egress/open-gate",
    "timeout_seconds": 10
  },

  "cdr_db": {
    "host": "127.0.0.1",
    "port": 3306,
    "username": "asterisk",
    "password": "",
    "database": "asterisk",
    "table": "cdr"
  },

  "dashboard": {
    "enabled": true,
    "service_level_target_seconds": 20,
    "reconcile_seconds": 60,
    "persist_snapshot_seconds": 5,
    "recommended_polling_ms": 2000,
    "min_polling_ms": 1000,
    "live_tick_ms": 1000,
    "snapshot_path": "/var/lib/amigow/queue-dashboard.snapshot.json",
    "events_path": "/var/lib/amigow/queue-dashboard.events.ndjson",
    "alerts": {
      "warning_longest_wait_seconds": 30,
      "critical_longest_wait_seconds": 60,
      "warning_waiting": 3,
      "critical_waiting": 6,
      "warning_service_level": 80,
      "critical_service_level": 70,
      "warning_abandon_rate": 3,
      "critical_abandon_rate": 5,
      "warning_asa_seconds": 30,
      "critical_asa_seconds": 60,
      "warning_paused_agents_percent": 30,
      "critical_paused_agents_percent": 50
    }
  }
}




